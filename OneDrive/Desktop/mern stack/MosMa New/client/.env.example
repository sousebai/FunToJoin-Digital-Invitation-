# ─── MosMa Client — Local Development Environment ────────────────────────────
# Copy this file to .env and fill in the values for local development.
# In production (Vercel), configure these variables directly in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL
VITE_API_URL=http://localhost:5000

# Backend Socket.IO server URL
VITE_SOCKET_URL=http://localhost:5000
